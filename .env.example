# Copy to .env and fill in. Nothing here is committed.

# SpacetimeDB. Local: http://localhost:3000. Maincloud: https://maincloud.spacetimedb.com
STDB_URI=http://localhost:3000
STDB_DB=venuemap
# Bridge identity token. Leave empty: the bridge mints one and caches it at ~/.venuemap/<server>/token
STDB_TOKEN=

# Salt mixed into every MAC before hashing. Raw MACs never leave the node process.
MAC_SALT=change-me-to-a-long-random-string

# Optional. Anthropic, for the ask bar and privacy receipts. Empty turns both off.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Optional. Cartesia, for voice in and out. Empty turns voice off.
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# Venue wifi the sniffer locks to (2.4 GHz channel of the "Cal Hacks 13.0" SSID)
VENUE_SSID=Cal Hacks 13.0
VENUE_CHANNEL=6

# Real nodes. Comma separated serial ports for ESP32 nodes, or empty.
SERIAL_PORTS=

# Optional. Postgres for zone history (TigerData / Timescale or any Postgres).
# Empty disables the history chart and the zone_history Ask tool.
TIGER_DSN=

# Optional. Moss semantic search over data/guide.json (portal.usemoss.dev).
# Empty disables the search_guide Ask tool and /api/search.
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
MOSS_INDEX=venuemap-guide

# Venue admin sign-in. GitHub OAuth app; empty signs everyone in as "local".
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Signs the admin session cookie. Empty: random per bridge start, sessions end on restart.
SESSION_SECRET=
# Origin the browser may be sent back to after sign-in (localhost origins are always allowed).
CLIENT_URL=http://localhost:5173
# Where browsers reach the bridge, for the OAuth callback and upload URLs. Empty: the request host.
PUBLIC_URL=

# Fetch.ai concierge agent
AGENTVERSE_KEY=
AGENT_SEED_PHRASE=venuemap concierge seed change me
BRIDGE_URL=http://localhost:8080

# Client (Vite reads VITE_* only)
VITE_STDB_URI=ws://localhost:3000
VITE_STDB_DB=venuemap
VITE_BRIDGE_URL=http://localhost:8080

# Copy to .env and fill in. Nothing here is committed.

# SpacetimeDB. Local: http://localhost:3000. Maincloud: https://maincloud.spacetimedb.com
STDB_URI=http://localhost:3000
STDB_DB=venuemap
# Bridge identity token. Leave empty: the bridge mints one and caches it at ~/.venuemap_token
STDB_TOKEN=

# Salt mixed into every MAC before hashing. Raw MACs never leave the node process.
MAC_SALT=change-me-to-a-long-random-string

# Anthropic, for the ask bar and privacy receipts
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5-5

# Cartesia, for voice in and out
CARTESIA_API_KEY=sk_car_...
CARTESIA_VOICE_ID=

# Venue wifi the sniffer locks to (2.4 GHz channel of the "Cal Hacks 13.0" SSID)
VENUE_SSID=Cal Hacks 13.0
VENUE_CHANNEL=6

# Real nodes. Comma separated serial ports for ESP32 nodes, or empty.
SERIAL_PORTS=

# Optional sinks. Empty disables them.
TIGER_DSN=
MOSS_URL=
MOSS_API_KEY=

# Fetch.ai concierge agent
AGENTVERSE_KEY=
AGENT_SEED_PHRASE=venuemap concierge seed change me
BRIDGE_URL=http://localhost:8080

# Client (Vite reads VITE_* only)
VITE_STDB_URI=ws://localhost:3000
VITE_STDB_DB=venuemap
VITE_BRIDGE_URL=http://localhost:8080
